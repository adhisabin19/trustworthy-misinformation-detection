   "source": [
    "## 4. Minimal preprocessing for descriptive analysis\n",
    "Created a whitespace-normalized copy and derived word/character counts. Preserved raw files and original text."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "eb656baf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "train rows preserved: 10240\n",
      "validation rows preserved: 1284\n",
      "test rows preserved: 1267\n",
      "Cleaned copies saved under reports/week3; raw TSV files unchanged.\n"
     ]
    }
   ],
   "source": [
    "def prepare(df):\n",
    "    out = df.copy()\n",
    "    out[\"statement_clean\"] = (out[\"statement\"].astype(\"string\")\n",
    "                              .str.replace(r\"\\s+\", \" \", regex=True).str.strip())\n",
    "    out[\"word_count\"] = out[\"statement_clean\"].fillna(\"\").str.split().str.len()\n",
    "    out[\"character_count\"] = out[\"statement_clean\"].fillna(\"\").str.len()\n",
    "    return out\n",
    "clean = {k:prepare(v) for k,v in splits.items()}\n",
    "for k in splits:\n",
    "    assert len(clean[k])==len(splits[k])\n",
    "    print(k, \"rows preserved:\", len(clean[k]))\n",
    "    clean[k].to_csv(OUT / f\"{k}_cleaned.csv\", index=False)\n",
    "print(\"Cleaned copies saved under reports/week3; raw TSV files unchanged.\")"
   ]
  },
