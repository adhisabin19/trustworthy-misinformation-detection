   "source": [
    "COLUMNS = [\n",
    "    \"id\", \"label\", \"statement\", \"subject\", \"speaker\", \"job_title\", \"state_info\",\n",
    "    \"party_affiliation\", \"barely_true_counts\", \"false_counts\", \"half_true_counts\",\n",
    "    \"mostly_true_counts\", \"pants_on_fire_counts\", \"context\"\n",
    "]\n",
    "LABEL_ORDER = [\"pants-fire\", \"false\", \"barely-true\", \"half-true\", \"mostly-true\", \"true\"]\n",
    "\n",
    "def read_split(filename):\n",
    "    return pd.read_csv(RAW / filename, sep=\"\\t\", header=None, names=COLUMNS,\n",
    "                       dtype={\"id\":\"string\"}, on_bad_lines=\"error\")\n",
    "\n",
    "splits = {\n",
    "    \"train\": read_split(\"train.tsv\"),\n",
    "    \"validation\": read_split(\"valid.tsv\"),\n",
    "    \"test\": read_split(\"test.tsv\")\n",
    "}\n",
    "counts = pd.DataFrame([{\"split\": k, \"rows\": len(v), \"columns\": v.shape[1]} for k,v in splits.items()])\n",
    "display(counts)\n",
    "counts.to_csv(TABLES / \"split_counts.csv\", index=False)\n",
    "print(\"Total:\", counts[\"rows\"].sum())\n",
    "assert all(df.shape[1] == 14 for df in splits.values()), \"Expected 14 TSV columns\"\n",
    "print(\"Training record preview:\")\n",
    "display(splits[\"train\"].head(3))"
