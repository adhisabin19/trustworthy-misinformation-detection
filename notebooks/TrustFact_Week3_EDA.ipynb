    "label_rows = []\n",
    "for split,df in clean.items():\n",
    "    counts_split = df[\"label\"].value_counts().reindex(LABEL_ORDER,fill_value=0)\n",
    "    unexpected = set(df[\"label\"].dropna().unique())-set(LABEL_ORDER)\n",
    "    if unexpected:\n",
    "        raise ValueError(f\"Unrecognized labels in {split}: {unexpected}\")\n",
    "    for label,count in counts_split.items():\n",
    "        label_rows.append({\"split\":split,\"label\":label,\"count\":int(count),\n",
    "                           \"pct\":round(100*count/len(df),2)})\n",
    "labels_df=pd.DataFrame(label_rows)\n",
    "display(labels_df.pivot(index=\"label\",columns=\"split\",values=\"count\").reindex(LABEL_ORDER))\n",
    "labels_df.to_csv(TABLES / \"label_distribution.csv\",index=False)\n",
    "plt.figure(figsize=(11,6))\n",
