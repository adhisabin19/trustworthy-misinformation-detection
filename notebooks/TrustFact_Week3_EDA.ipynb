    "def normalize_text(text):\n",
    "    if pd.isna(text): return None\n",
    "    return re.sub(r\"\\s+\", \" \", str(text)).strip().casefold()\n",
    "\n",
    "text_sets = {k:set(df[\"statement\"].map(normalize_text).dropna())-{''} for k,df in splits.items()}\n",
    "id_sets = {k:set(df[\"id\"].dropna()) for k,df in splits.items()}\n",
    "pairs = [(\"train\",\"validation\"),(\"train\",\"test\"),(\"validation\",\"test\")]\n",
    "overlap_df = pd.DataFrame([\n",
    "    {\"split_a\":a,\"split_b\":b,\n",
    "     \"normalized_text_overlap\":len(text_sets[a]&text_sets[b]),\n",
    "     \"id_overlap\":len(id_sets[a]&id_sets[b])}\n",
    "    for a,b in pairs\n",
    "])\n",
    "display(overlap_df)\n",
    "overlap_df.to_csv(TABLES / \"split_overlap.csv\",index=False)\n",
    "print(\"Investigate any overlap before interpreting final model generalization.\")"
   ]
  },
