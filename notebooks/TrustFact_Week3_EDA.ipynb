    "from pathlib import Path\n",
    "import re\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from IPython.display import display\n",
    "\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "pd.set_option(\"display.max_columns\", 30)\n",
    "\n",
    "cwd = Path.cwd().resolve()\n",
    "candidates = [cwd, cwd.parent, cwd.parent.parent]\n",
    "ROOT = next((x for x in candidates if (x / \"data\" / \"raw\" / \"liar\").is_dir()), None)\n",
    "if ROOT is None:\n",
    "    raise FileNotFoundError(\n",
    "        \"Cannot find data/raw/liar/. Open the project in VS Code and put train.tsv, valid.tsv, test.tsv there. \"\n",
    "        f\"Notebook working directory: {cwd}\"\n",
    "    )\n",
    "RAW = ROOT / \"data\" / \"raw\" / \"liar\"\n",
    "OUT = ROOT / \"reports\" / \"week3\"\n",
    "FIGURES = OUT / \"figures\"\n",
    "TABLES = OUT / \"tables\"\n",
    "for folder in (FIGURES, TABLES):\n",
    "    folder.mkdir(parents=True, exist_ok=True)\n",
    "print(\"Project root:\", ROOT)\n",
    "print(\"Source folder:\", RAW)\n",
    "print(\"Outputs:\", OUT)\n",
    "for filename in (\"train.tsv\", \"valid.tsv\", \"test.tsv\"):\n",
    "    f = RAW / filename\n",
    "    print(filename, \"FOUND\" if f.is_file() else \"MISSING\")\n",
    "    if not f.is_file():\n",
    "        raise FileNotFoundError(f\"Missing {f}\")"
   ]
  },
